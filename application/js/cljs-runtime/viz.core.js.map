(def percent-of-passengers-per-family-members-on-board
 (apply vector "bar"
  (query-data nil enhanced-titanic
   (fn [data]
     (let [grouped (group-by #(+ (get-n % "Parch") (+ (get-n % "SibSp"))) data)
           sorted (sort-by first grouped)]
       ((fn [per]
          ["Percent of passengers per family members on board" "Family mems. board" "% pass." (map first per) (map second per)])
        (reduce (fn [acc [k v]]
         (let [percent (* 100 (/ (count v) (count data)))]
           (conj acc [k (float percent)])))
         []
         sorted)))))))

(def most-common-ages-amongst-survivors-m
 (apply vector "bar"
  (query-data [#(= 1 (get-n % "Survived"))] male-passengers
   (fn [data]
    (let [age (map (comp int read-string #(get % "Age")) data)
          group (group-by identity age)
          size-age (count age)
          xs (keys group)
          ys (map #(* 100 (/ (count %) size-age)) (vals group))
          title "Most common ages amongst the male survivors of the titanic"]
      [title "Ages" "Survivors" xs ys])))))

