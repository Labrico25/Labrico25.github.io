(defn change-if [value fn]
  (let [v (.. value -target -value)]
    (if (= "" v)
        (fn)
        (fn v))))

(defn plot-new-v [kind title xaxes yaxes xs ys index]
  ;(println kind)
  (r/create-class
   {:component-did-mount
    (fn [this]
      (let [context (.getContext (.getElementById js/document (str "a-plot" index)) "2d")
            plot-template (fn [data]
                           (js/Chart. context
                            (clj->js {:type kind :data data 
                                      :options {:legend {:display false}
                                                :scales {:xAxes [{:scaleLabel {:display true :labelString xaxes}}]
                                                         :yAxes [{:ticks {:beginAtZero true} 
                                                         :scaleLabel {:display true :labelString yaxes}}]}}})))
            for-bar (fn [data-kword-v]
                     (let [size (count ys)
                           backcolors (take size (cycle ["red" "green" "black"]))]
                       [{:backgroundColor backcolors :data data-kword-v}]))]
        (case kind
         "bar" (plot-template {:labels xs :datasets (for-bar ys)})
         "line" (plot-template {:labels xs :datasets [{:backgroundColor "red" :data ys :fill false :borderColor "red"}]})
         "scatter" (js/Chart. context
                    (clj->js {:type "line"
                              :data {:labels xs
                                     :datasets [{:backgroundColor "red" :data ys :fill false :showLine false}]}
                              :options {:legend {:display false}
                                        :scales {:xAxes [{:scaleLabel {:display true :labelString xaxes}}]
                                                         :yAxes [{:ticks {:beginAtZero true} 
                                                         :scaleLabel {:display true :labelString yaxes}}]}}})))))
    :reagent-render
    (fn []
      [:canvas {:id (str "a-plot" index)}])}))

(defn do-if [ATOM fn]
  (if (= ATOM "")
      (fn)
      (fn ATOM)))

(defn make-style [index]
  (let [[x y] (cond
               (zero? index) [80 100]
               (= index 1) [1000 100]
               (odd? index) [1000 (* (dec index) 300)]
               (even? index) [80 (* index 300)])]
    {:position "absolute"
     :left (str x "px")
     :top (str y "px")
     :width "600px"
     :height "500px"}))

(defonce plots (r/atom []))

(defonce p-c-states (r/atom {}))

(defn dis-vc [vc index]
  (let [updated (update vc index (constantly :nil))]
    (reduce #(if (= %2 :nil) %1 (conj %1 %2)) [] updated)))

(defn clear [this index]
  (swap! plots dis-vc index)
  (swap! p-c-states
   (fn [states]
    (let [veced (vec states)
          remd (dis-vc veced index)
          idxs (range (count remd))
          new-thisses (map #(str "plot-container-" %) idxs)]
      (zipmap new-thisses (map second remd))))))

(def plot-data
 {0 survived-count-by-sex
  1 survival-rate-of-passengers-per-family-members-on-board
  2 percent-of-total-survived-by-family-members
  3 total-%-of-survivors-by-parch
  4 total-%-of-survivors-by-sibsp
  5 percent-of-passengers-per-family-members-on-board
  6 most-common-ages-amongst-survivors-m
  7 survivors-per-pclass-m
  8 survival-rate-per-port
  9 %-of-survivors-by-family-number-m
  10 survival-rate-per-age-f
  11 survival-rate-per-port-embarked-f
  12 survival-per-family-members-on-board-f
  13 survival-%-per-pclass-f})

(defn indexi-key [SEQ]
  (map
   (fn [element]
    (mapv
     (fn [item]
      (if (map? item)
        (assoc item :key (gensym))
        item)) 
     element)) 
   SEQ))

(defn make-it [this value callback plot-if index]
  ;(println value)
  (let [style (make-style index)
        get-title {"enhanced-titanic" "all passengers" 
                   "male"             "male passengers" 
                   "female"           "female passengers"}
        template (fn [& SEQ]
    ^{:key index} [(fn []
                    [:div {:id (str "plot-container-" index) :style style}
                     [:h1 (get-title value)]
                     [:select {:id (str "select-cont-" index) :value (get @p-c-states this) :on-change #(change-if % callback)}
                      [:<> (indexi-key SEQ)]]
                     [:button {:on-click #(clear this index)} "X"]
                     (plot-if @p-c-states)])])]
    (case value
     "enhanced-titanic"
      (template [:option {:value ""} "NIL"]
                [:option {:value 0} "Survival count (Sex)"]
                [:option {:value 1} "Survival % passengers (family)"]
                [:option {:value 2} "% total survived (family)"]
                [:option {:value 3} "% survivors by Parch"]
                [:option {:value 4} "% survivors by SibSp"]
                [:option {:value 5} "% passengers by family num."])
     "male"
      (template [:option {:value ""} "NIL"]
                [:option {:value 6} "Most common ages (male surv.)"]
                [:option {:value 7} "Survivors(%) per Pclass"]
                [:option {:value 8}  "Survival rate per port"]
                [:option {:value 9} "% survival by family num."])
     "female"
      (template [:option {:value ""} "NIL"]
                [:option {:value 10} "Survival % per Age"] 
                [:option {:value 11} "% per port Embarked (%)"]
                [:option {:value 12} "Survival % by family num."]
                [:option {:value 13} "Rate of survival by pclass"])
     nil)))

(defn update-if [index]
  (let [this (str "plot-container-" index)]
    (when-not (get @p-c-states this)
      (swap! p-c-states assoc this ""))))

(defn create-plot [new-val size]
  (let [idxs (range size)]
   (mapcat
    (fn [index]
     (let [callback (fn
                     ([] (swap! p-c-states assoc (str "plot-container-" index) ""))
                     ([new-v] (swap! p-c-states assoc (str "plot-container-" index) new-v)))
           plot-if (fn [states]
                    (let [state (nth (vals states) index)]
                      (do-if state
                       (fn
                        ([] [:div])
                        ([state]
                         (let [[kind title xaxes yaxes xs ys :as all] (get plot-data (read-string state))]
                           [:div
                            [:h3 {:font-size "10px"} title]
                            [plot-new-v kind title xaxes yaxes xs ys index]]))))))]
       (update-if index)
       (list ^{:key index} [make-it (str "plot-container-" index) (@plots index) callback plot-if index])))
       idxs)))


(defn initialize
  ([]
   (swap! p-c-states (constantly {}))
   (swap! plots (constantly []))
   (dom/render [(fn []
		  [:div {:style {:text-align "center"}}
		   [:label {:for "passenger-list"} "Choose a passenger list"]
		   [:select {:on-change #(change-if % initialize)}
                    [:option {:value ""} "None"]
		    [:option {:value "enhanced-titanic"} "All passengers"]
		    [:option {:value "male"} "male passengers"]
                    [:option {:value "female"} "female passengers"]]])]
    (js/document.getElementById "application")))
  ([new-val]
   (swap! plots conj new-val)
   (dom/render [(fn []
		  [:div {:style {:text-align "center"}}
		   [:label {:for "passenger-list"} "Choose a passenger list"]
		   [:select {:value new-val :on-change #(change-if % initialize)}
                    [:option {:value ""} "None"]
                    [:option {:value "enhanced-titanic"} "All passengers"]
                    [:option {:value "male"} "male passengers"]
                    [:option {:value "female"} "female passengers"]]
                   (create-plot new-val (count @plots))])]
    (js/document.getElementById "application"))))

(defn init []
  (initialize))