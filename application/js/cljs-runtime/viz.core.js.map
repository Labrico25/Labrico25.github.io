(ns viz.core
  (:require [cljs.reader :refer [read-string]])
  (:require [reagent.dom :as dom])
  (:require [reagent.core :as r])
  (:require [goog.string :refer [format]])
  (:require [clojure.string :refer [split]]))

(def query (fn [v pred-fn coll] (filter #(= (pred-fn %) v) coll)))

(defn read-text-file [file]
  (let [rawfile (new js/XMLHttpRequest)]
      (.open rawfile "GET" file false)
      (set! (. rawfile -onreadystatechange)
            (fn []
              (if (or (= (. rawfile -status) 200) (= (. rawfile -status) 0))
                  (let [alltext (. rawfile -responseText)]
                      (println alltext)))))
      (.send rawfile)))

(def enhanced-titanic (read-string (with-out-str (read-text-file "datasets/titanic-enhanced-data.txt"))))

(def male-passengers (query "male" #(get % "Sex") enhanced-titanic))

(def female-passengers (query "female" #(get % "Sex") enhanced-titanic))

(defn read-n* [n]
  (cond
   (int? n) n
   (float? n) n
   (double? n) n
   (string? n) (if (read-n* (read-string n)) (read-string n) n)))

(def get-n (comp read-n* get))

(defn query-data
 ([[query & queries] coll]
  (if query
    (filter query (query-data queries coll))
    coll))
 ([query coll do-after]
  (do-after
   (query-data query coll))))

(def survived-count-by-sex
 ["bar"
  "Survivor count by sex"
  "Sex"
  "Survivors"
  ["female" "male"] 
  [((comp count filter) #{1} (map (comp read-n* #(get % "Survived")) female-passengers))
   ((comp count filter) #{1} (map (comp read-n* #(get % "Survived")) male-passengers))]])

(def survival-rate-of-passengers-per-family-members-on-board
 (apply vector "line"
  (query-data nil enhanced-titanic
   (fn [data]
     (let [by-fam (group-by #(+ (get-n % "Parch") (get-n % "SibSp")) data)
           sorted (sort-by first by-fam)]
       ((fn [per]
          (let [title "Survival rate of passengers per family members on board"]
            [title "Family members" "Survival rate" (map first per) (map second per)]))
        (reduce (fn [vc [k v]]
                  (let [surv-p (query-data [#(= 1 (get-n % "Survived"))]
                                           v
                                           #(* 100 (/ (count %) (count v))))]
                    (conj vc [k (float surv-p)]))) [] sorted)))))))

(def percent-of-total-survived-by-family-members
 (apply vector "line"
  (query-data [#(= 1 (get-n % "Survived"))] enhanced-titanic
   (fn [data]
     (let [by-fam (group-by #(+ (get-n % "Parch") (get-n % "SibSp")) data)
           sorted (sort-by first by-fam)]
       ((fn [per]
          (let [title "Percent of total survived by family members"]
            [title "Family mem." "% Total survived" (map first per) (map second per)]))
        (reduce (fn [vc [k v]]
         (let [percent (* 100 (/ (count v) (count data)))]
           (conj vc [k (float percent)])))
         []
         sorted)))))))

(def total-%-of-survivors-by-parch
 (apply vector "bar"
  (query-data [#(= 1 (get-n % "Survived"))] enhanced-titanic
   (fn [data]
     (let [by-parch (group-by #(get-n % "Parch") data)
           sort-parch (sort-by first by-parch)]
       ((fn [parch-per]
          ["Total % of survivors by Parch" "Parch Number" "Survivors (%)" (map first parch-per) (map second parch-per)])
        (reduce (fn [acc [k v]]
         (let [percent (* 100 (/ (count v) (count data)))]
           (conj acc [k (float percent)]))) 
         [] 
         sort-parch)))))))

